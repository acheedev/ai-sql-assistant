set pagesize 500
set linesize 240
set trimspool on
set feedback on
set verify off
set tab off

prompt === EXACT SEMANTIC TABLE COUNTS ===

select 'T_SEMANTIC_COLUMN' as table_name,
       count(*) as exact_row_count
from t_semantic_column

union all

select 'T_SEMANTIC_EXAMPLE_QUESTION',
       count(*)
from t_semantic_example_question

union all

select 'T_SEMANTIC_OBJECT',
       count(*)
from t_semantic_object

union all

select 'T_SEMANTIC_OBJECT_ALIAS',
       count(*)
from t_semantic_object_alias

order by table_name;


prompt === SEMANTIC TABLE COLUMN DEFINITIONS ===

select
    table_name,
    column_id,
    column_name,
    data_type,
    data_length,
    char_length,
    char_used,
    data_precision,
    data_scale,
    nullable,
    data_default,
    identity_column,
    virtual_column,
    hidden_column
from user_tab_cols
where table_name in (
    'T_SEMANTIC_COLUMN',
    'T_SEMANTIC_EXAMPLE_QUESTION',
    'T_SEMANTIC_OBJECT',
    'T_SEMANTIC_OBJECT_ALIAS'
)
order by
    table_name,
    column_id;


prompt === SEMANTIC TABLE CONSTRAINTS ===

select
    c.table_name,
    c.constraint_name,
    case c.constraint_type
        when 'P' then 'PRIMARY KEY'
        when 'R' then 'FOREIGN KEY'
        when 'U' then 'UNIQUE'
        when 'C' then 'CHECK / NOT NULL'
        when 'V' then 'VIEW CHECK OPTION'
        when 'O' then 'VIEW READ ONLY'
        else c.constraint_type
    end as constraint_type,
    cc.column_name,
    cc.position as column_position,
    c.status,
    c.validated,
    c.deferrable,
    c.deferred,
    c.delete_rule,
    r.table_name as referenced_table,
    rc.column_name as referenced_column
from user_constraints c
left join user_cons_columns cc
    on cc.owner = c.owner
   and cc.constraint_name = c.constraint_name
   and cc.table_name = c.table_name
left join user_constraints r
    on r.owner = c.r_owner
   and r.constraint_name = c.r_constraint_name
left join user_cons_columns rc
    on rc.owner = r.owner
   and rc.constraint_name = r.constraint_name
   and rc.position = cc.position
where c.table_name in (
    'T_SEMANTIC_COLUMN',
    'T_SEMANTIC_EXAMPLE_QUESTION',
    'T_SEMANTIC_OBJECT',
    'T_SEMANTIC_OBJECT_ALIAS'
)
order by
    c.table_name,
    c.constraint_name,
    cc.position;


prompt === SEMANTIC TABLE INDEXES ===

select
    i.table_name,
    i.index_name,
    i.index_type,
    i.uniqueness,
    i.status,
    ic.column_position,
    ic.column_name,
    ic.descend
from user_indexes i
join user_ind_columns ic
    on ic.index_name = i.index_name
   and ic.table_name = i.table_name
where i.table_name in (
    'T_SEMANTIC_COLUMN',
    'T_SEMANTIC_EXAMPLE_QUESTION',
    'T_SEMANTIC_OBJECT',
    'T_SEMANTIC_OBJECT_ALIAS'
)
order by
    i.table_name,
    i.index_name,
    ic.column_position;


prompt === SEMANTIC TABLE AND COLUMN COMMENTS ===

select
    table_name,
    comments
from user_tab_comments
where table_name in (
    'T_SEMANTIC_COLUMN',
    'T_SEMANTIC_EXAMPLE_QUESTION',
    'T_SEMANTIC_OBJECT',
    'T_SEMANTIC_OBJECT_ALIAS'
)
order by table_name;


select
    table_name,
    column_name,
    comments
from user_col_comments
where table_name in (
    'T_SEMANTIC_COLUMN',
    'T_SEMANTIC_EXAMPLE_QUESTION',
    'T_SEMANTIC_OBJECT',
    'T_SEMANTIC_OBJECT_ALIAS'
)
order by
    table_name,
    column_name;

