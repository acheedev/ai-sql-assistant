set pagesize 500
set linesize 1000
set trimspool on
set feedback on
set verify off
set tab off

prompt === SEMANTIC OBJECT COVERAGE SUMMARY ===

select
    o.object_name,
    o.object_type,
    o.business_name,
    o.include_in_ai,
    o.preferred_for_ai,
    o.default_rank,
    o.status,
    (
        select count(*)
        from t_semantic_column c
        where c.object_name = o.object_name
    ) as semantic_column_count,
    (
        select count(*)
        from user_tab_cols pc
        where pc.table_name = o.object_name
          and pc.hidden_column = 'NO'
    ) as physical_column_count,
    (
        select count(*)
        from t_semantic_object_alias a
        where a.object_name = o.object_name
    ) as alias_count,
    (
        select count(*)
        from t_semantic_example_question q
        where q.preferred_object_name = o.object_name
    ) as example_count
from t_semantic_object o
order by
    o.default_rank,
    o.object_name;


prompt === SEMANTIC OBJECTS MISSING OR TYPE-MISMATCHED IN ORACLE ===

select
    o.object_name,
    o.object_type as semantic_object_type,
    uo.object_type as physical_object_type,
    o.status,
    o.include_in_ai
from t_semantic_object o
left join user_objects uo
    on uo.object_name = o.object_name
   and uo.object_type in ('TABLE', 'VIEW')
where uo.object_name is null
   or upper(o.object_type) <> uo.object_type
order by o.object_name;


prompt === PHYSICAL VIEWS WITHOUT SEMANTIC REGISTRATION ===

select
    uv.view_name
from user_views uv
left join t_semantic_object o
    on o.object_name = uv.view_name
where o.object_name is null
order by uv.view_name;


prompt === SEMANTIC COLUMNS MISSING FROM PHYSICAL OBJECTS ===

select
    sc.object_name,
    sc.column_name,
    sc.business_name,
    o.status,
    o.include_in_ai
from t_semantic_column sc
join t_semantic_object o
    on o.object_name = sc.object_name
left join user_tab_cols pc
    on pc.table_name = sc.object_name
   and pc.column_name = sc.column_name
   and pc.hidden_column = 'NO'
where pc.column_name is null
order by
    sc.object_name,
    sc.display_rank,
    sc.column_name;


prompt === PHYSICAL COLUMNS MISSING SEMANTIC METADATA ===

select
    o.object_name,
    pc.column_id,
    pc.column_name,
    pc.data_type,
    o.status,
    o.include_in_ai
from t_semantic_object o
join user_tab_cols pc
    on pc.table_name = o.object_name
   and pc.hidden_column = 'NO'
left join t_semantic_column sc
    on sc.object_name = o.object_name
   and sc.column_name = pc.column_name
where sc.column_name is null
order by
    o.object_name,
    pc.column_id;


prompt === FOREIGN-KEY ORPHAN CHECKS ===

select
    'SEMANTIC_COLUMN -> SEMANTIC_OBJECT' as integrity_check,
    count(*) as orphan_count
from t_semantic_column c
left join t_semantic_object o
    on o.object_name = c.object_name
where o.object_name is null

union all

select
    'SEMANTIC_ALIAS -> SEMANTIC_OBJECT',
    count(*)
from t_semantic_object_alias a
left join t_semantic_object o
    on o.object_name = a.object_name
where o.object_name is null

union all

select
    'EXAMPLE_QUESTION -> SEMANTIC_OBJECT',
    count(*)
from t_semantic_example_question q
left join t_semantic_object o
    on o.object_name = q.preferred_object_name
where o.object_name is null;


prompt === OBJECT FLAG AND STATUS DISTRIBUTION ===

select
    status,
    include_in_ai,
    preferred_for_ai,
    count(*) as object_count
from t_semantic_object
group by
    status,
    include_in_ai,
    preferred_for_ai
order by
    status,
    include_in_ai,
    preferred_for_ai;


prompt === LOGICALLY INCONSISTENT OBJECT FLAGS ===

select
    object_name,
    status,
    include_in_ai,
    preferred_for_ai
from t_semantic_object
where (preferred_for_ai = 'Y' and include_in_ai <> 'Y')
   or (include_in_ai = 'Y' and status <> 'ACTIVE')
order by object_name;


prompt === ENABLED EXAMPLES TARGETING DISABLED OBJECTS ===

select
    q.preferred_object_name,
    count(*) as enabled_example_count,
    o.status,
    o.include_in_ai
from t_semantic_example_question q
join t_semantic_object o
    on o.object_name = q.preferred_object_name
where q.is_enabled = 'Y'
  and (
        o.status <> 'ACTIVE'
        or o.include_in_ai <> 'Y'
      )
group by
    q.preferred_object_name,
    o.status,
    o.include_in_ai
order by q.preferred_object_name;


prompt === EXAMPLE COVERAGE BY OBJECT ===

select
    o.object_name,
    count(q.example_question_id) as total_examples,
    sum(
        case
            when q.is_enabled = 'Y' then 1
            else 0
        end
    ) as enabled_examples,
    sum(
        case
            when q.exemplar_sql is not null then 1
            else 0
        end
    ) as examples_with_sql,
    sum(
        case
            when q.is_enabled = 'Y'
             and q.exemplar_sql is null then 1
            else 0
        end
    ) as enabled_without_sql
from t_semantic_object o
left join t_semantic_example_question q
    on q.preferred_object_name = o.object_name
group by o.object_name
order by
    total_examples desc,
    o.object_name;


prompt === NORMALIZED ALIAS COLLISIONS ===

select
    upper(trim(alias_term)) as normalized_alias,
    count(*) as alias_rows,
    count(distinct object_name) as object_count,
    listagg(object_name, ', ')
        within group (order by object_name) as registered_objects
from t_semantic_object_alias
group by upper(trim(alias_term))
having count(*) > 1
order by
    object_count desc,
    normalized_alias;


prompt === DUPLICATE COLUMN DISPLAY RANKS ===

select
    object_name,
    display_rank,
    count(*) as columns_at_rank
from t_semantic_column
group by
    object_name,
    display_rank
having count(*) > 1
order by
    object_name,
    display_rank;


prompt === SEMANTIC COLUMN FLAG DISTRIBUTION ===

select
    is_human_readable,
    is_identifier,
    is_default_select,
    is_filterable,
    count(*) as column_count
from t_semantic_column
group by
    is_human_readable,
    is_identifier,
    is_default_select,
    is_filterable
order by
    is_human_readable,
    is_identifier,
    is_default_select,
    is_filterable;
    
    
