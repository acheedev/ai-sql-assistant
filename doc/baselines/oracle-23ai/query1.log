set pagesize 200
set linesize 220
set trimspool on
set feedback on
set verify off

prompt === SESSION IDENTITY ===

select
    sys_context('USERENV', 'SESSION_USER')    as session_user,
    sys_context('USERENV', 'CURRENT_SCHEMA')  as current_schema,
    sys_context('USERENV', 'DB_NAME')         as database_name,
    sys_context('USERENV', 'CON_NAME')        as container_name,
    sys_context('USERENV', 'SERVICE_NAME')    as service_name
from dual;

prompt === DATABASE VERSION ===

select banner_full
from v$version
where banner_full like 'Oracle Database%';

prompt === OWNED OBJECTS ===

select
    object_type,
    count(*) as object_count
from user_objects
group by object_type
order by object_type;

prompt === TABLES AND VIEWS ===

select table_name
from user_tables
order by table_name;

select view_name
from user_views
order by view_name;

prompt === TABLE ROW COUNTS FROM STATISTICS ===

select
    table_name,
    num_rows,
    last_analyzed
from user_tables
order by table_name;

prompt === DIRECT SYSTEM PRIVILEGES ===

select privilege
from user_sys_privs
order by privilege;

prompt === DIRECT OBJECT PRIVILEGES RECEIVED ===

select
    owner,
    table_name,
    privilege,
    grantor
from user_tab_privs_recd
order by owner, table_name, privilege;

prompt === ENABLED ROLES ===

select role
from session_roles
order by role;


