prompt === SEMANTIC OBJECT CONTENT ===

select
    object_name,
    object_type,
    business_name,
    short_description,
    include_in_ai,
    preferred_for_ai,
    default_rank,
    status
from t_semantic_object
order by
    default_rank,
    object_name;
    
    



prompt === SEMANTIC COLUMN CONTENT ===

select
    object_name,
    column_name,
    business_name,
    is_human_readable,
    is_identifier,
    is_default_select,
    is_filterable,
    display_rank
from t_semantic_column
order by
    object_name,
    display_rank,
    column_name;


prompt === SEMANTIC ALIAS CONTENT ===

select
    object_name,
    alias_term,
    alias_weight
from t_semantic_object_alias
order by
    object_name,
    alias_weight desc,
    alias_term;


prompt === SEMANTIC EXAMPLE QUESTION CONTENT ===

select
    example_question_id,
    preferred_object_name,
    is_enabled,
    question_text,
    dbms_lob.substr(exemplar_sql, 4000, 1) as exemplar_sql
from t_semantic_example_question
order by
    preferred_object_name,
    example_question_id;
    
